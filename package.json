{
  "name": "@vanduo-oss/charts",
  "version": "0.1.0",
  "description": "Standalone SVG-first chart components for Vanduo dashboards and docs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./css": "./dist/vanduo-charts.css",
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs",
      "default": "./dist/vue.js"
    },
    "./iife": {
      "default": "./dist/vanduo-charts.iife.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vanduo",
    "charts",
    "svg",
    "dashboard",
    "bar-chart",
    "line-chart",
    "donut-chart"
  ],
  "license": "MIT",
  "author": "vanduo-oss",
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "homepage": "https://vanduo.dev/#docs/vd-charts",
  "repository": {
    "type": "git",
    "url": "https://github.com/vanduo-oss/charts"
  },
  "sideEffects": [
    "./dist/vanduo-charts.css",
    "./dist/vanduo-charts.iife.js"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "esbuild": "^0.27.7",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@playwright/test",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.28.2"
}
